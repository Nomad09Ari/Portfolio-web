<% layout("layouts/boilerplate") %>

<div class="row">
  <h1 class="text-center">Мэдээлэл шинэчлэх</h1>
  <div class="offset-3 col-6">
    <form
      action="/campgrounds/<%= campground._id  %>?_method=PUT"
      method="POST"
    >
      <div class="mb-3">
        <label class="form-label" for="title">Нэршил</label>
        <input
          class="form-control"
          type="text"
          name="campground[title]"
          id="title"
          value="<%= campground.title %>"
        />
      </div>
      <div class="mb-3">
        <label class="form-label" for="location">Байршил</label>
        <input
          class="form-control"
          type="text"
          name="campground[location]"
          id="location"
          value="<%= campground.location %>"
        />
      </div>
      <div class="mb-3">
        <label class="form-label" for="image">URL холбоос</label>
        <input
          class="form-control"
          type="text"
          name="campground[image]"
          id="image"
          value="<%= campground.image %>"
        />
      </div>
      <div class="mb-3">
        <label for="price" class="form-label">Үнэ</label>
        <div class="input-group">
          <span class="input-group-text" id="price">MNT</span>
          <input
            type="text"
            class="form-control"
            placeholder="0"
            aria-label="price"
            aria-describedby="price-label"
            name="campground[price]"
            value="<%= campground.price %>"
          />
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="description">Тайлбар мэдээлэл</label>
        <textarea
          class="form-control"
          type="text"
          name="campground[description]"
          id="description"
          value="<%= campground.description %>"
        ></textarea>
      </div>
      <div class="mb-3">
        <button class="btn btn-info">Шинэчлэх</button>
      </div>
    </form>
    <a href="/campgrounds">Жагсаалтад буцах</a>
  </div>
</div>
