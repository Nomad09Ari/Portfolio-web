<% layout("layouts/boilerplate") %>
<div class="row">
  <div class="offset-3 col-6">
    <div class="card mb-3">
      <img src="<%= campground.image  %>" class="card-img-top" alt="..." />
      <div class="card-body">
        <h5 class="card-title"><%= campground.title %></h5>
        <p class="card-text"><%= campground.descriptions1 %></p>
      </div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item text-body-secondary">
          <%= campground.location %>
        </li>
        <li class="list-group-item">MNT<%= campground.price %> /хоног</li>

        <li class="list-group-item">A third item</li>
      </ul>
      <div class="card-body">
        <a class="btn btn-info" href="/campgrounds/<%= campground._id %>/edit"
          >Мэдээлэл шинэчлэх</a
        >
        <form
          class="d-inline"
          action="/campgrounds/<%= campground._id  %>?_method=DELETE"
          method="POST"
        >
          <button class="btn btn-danger">Устгах</button>
        </form>
      </div>
      <div class="card-footer text-body-secondary">1 day ago</div>
    </div>
  </div>
</div>
